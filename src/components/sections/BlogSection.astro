---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/format";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

<section class="page" id="blog" data-scrollspy-section aria-labelledby="blog-title">
  <div class="wrap">
    <header class="section-head">
      <p class="section-kicker">From the lab</p>
      <h2 id="blog-title">Blog</h2>
      <p>Notes from lab members on projects, papers and what we learn along the way.</p>
    </header>
    <div class="posts">
      {posts.map(({ data }) => (
        <article class="post">
          <time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time>
          <h3>{data.title}</h3>
          <p>{data.text}</p>
          {data.url && <a class="text-link" href={data.url}>Read post</a>}
        </article>
      ))}
    </div>
  </div>
</section>
