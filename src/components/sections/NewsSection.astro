---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/format";

interface Props {
  news: CollectionEntry<"news">[];
}

const { news } = Astro.props;
const groups = [
  { category: "world", title: "AI & ML worldwide", description: "Selected developments from primary sources. Reviewed September 16, 2026." },
  { category: "lab", title: "Lab news", description: "Updates from our team." },
] as const;
---

<section class="page" id="news" data-scrollspy-section aria-labelledby="news-title">
  <div class="wrap">
    <header class="section-head">
      <p class="section-kicker">Latest activity</p>
      <h2 id="news-title">News</h2>
      <p>News from our lab and the wider AI and machine learning community.</p>
    </header>
    {groups.map((group) => (
    <section class="news-group" aria-labelledby={`news-${group.category}`}>
    <h3 id={`news-${group.category}`} class="h2">{group.title}</h3>
    <p class="muted">{group.description}</p>
    <ul class="news-list">
      {news.filter(({ data }) => data.category === group.category).map(({ data }) => (
        <li class="news-item">
          <time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time>
          <div><h4>{data.title}</h4><p>{data.text}</p>
            {data.source && <a class="text-link" href={data.source.url} target="_blank" rel="noopener noreferrer">Source: {data.source.name} ↗</a>}
          </div>
        </li>
      ))}
    </ul>
    </section>
    ))}
  </div>
</section>
