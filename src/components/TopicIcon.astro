---
interface Props {
  name: "clinical" | "vision" | "language" | "people" | "learning" | "environment" | "algorithms";
}

const { name } = Astro.props;
---

<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "clinical" && <><path d="M16 27S5 20.4 5 11.9A6 6 0 0 1 16 8.6a6 6 0 0 1 11 3.3C27 20.4 16 27 16 27Z" /><path d="M9 16h4l2-4 3 8 2-4h3" /></>}
  {name === "vision" && <><path d="M3.5 16S8 9 16 9s12.5 7 12.5 7S24 23 16 23 3.5 16 3.5 16Z" /><circle cx="16" cy="16" r="4" /></>}
  {name === "language" && <><path d="M5 6h22v16H14l-6 5v-5H5Z" /><path d="M10 11h12M10 16h8" /></>}
  {name === "people" && <><circle cx="11" cy="11" r="4" /><circle cx="22.5" cy="12.5" r="3" /><path d="M4 26c.7-5 3-8 7-8s6.3 3 7 8M18 20c4.8-.8 8.2 1.2 9 5" /></>}
  {name === "learning" && <><path d="m3 11 13-6 13 6-13 6Z" /><path d="M8 14v7c4 3 12 3 16 0v-7M29 11v9" /></>}
  {name === "environment" && <><path d="M25 5C14 6 7 11 7 20c0 4 3 7 7 7 9 0 12-10 11-22Z" /><path d="M8 25c4-6 8-10 14-14" /></>}
  {name === "algorithms" && <><circle cx="16" cy="6" r="3" /><circle cx="8" cy="16" r="3" /><circle cx="24" cy="16" r="3" /><circle cx="5" cy="27" r="3" /><circle cx="16" cy="27" r="3" /><circle cx="27" cy="27" r="3" /><path d="m14 8-4 5m8-5 4 5M8 19l-2 5m4-5 4 5m10-5-6 5m8-5v5" /></>}
</svg>
